# PlatformIO build output and metadata
.pio/
.pioenvs/
.piolibdeps/

# IDE
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.idea/

# Local config backup exported from the board (may hold wifi/mqtt secrets)
.env

# The whole LittleFS image is build output: tools/pack_web.py writes www/ from
# web/, tools/env_to_fsdata.py writes data/ from .env. The latter carries the
# same WiFi and MQTT passwords as .env itself.
fsdata/

# OS / filesystem cruft
.DS_Store
Thumbs.db
$RECYCLE.BIN/
System Volume Information/

# Python bytecode from the desktop tool
tools/__pycache__/
