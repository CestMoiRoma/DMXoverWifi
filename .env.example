# Copy to .env (gitignored) and fill in what you want a freshly flashed board
# to start with. tools/env_to_fsdata.py reads this file before every build and
# writes the matching fsdata/data/*.json into the LittleFS image, so the values
# land on the board with `pio run -e s2mini -t uploadfs`.
#
# Semantics:
#   - .env is the source of truth. The generated files are rebuilt from scratch
#     on every build, and dropping a group here drops it from the image.
#   - A group with no keys at all produces no file, and the firmware falls back
#     to its own defaults for that group.
#   - `uploadfs` erases the whole LittleFS partition, so it also discards what
#     the board saved at runtime. Grab Settings > Export .env first if you want
#     to keep the live config.
#
# --- WiFi networks (numbered groups) ------------------------------------
# Priority is optional (default 0); higher wins when the board picks a
# network at boot.

WIFI_1_SSID=MyHomeWifi
WIFI_1_PASSWORD=changeme
WIFI_1_PRIORITY=10

WIFI_2_SSID=BackupHotspot
WIFI_2_PASSWORD=changeme
WIFI_2_PRIORITY=5

# --- MQTT ---------------------------------------------------------------

MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=dmxwifi
MQTT_DISCOVERY_PREFIX=homeassistant

# --- System / DMX / hotspot / static IP ----------------------------------
# Pin labels are cosmetic, only the digits matter: IO4, GPIO4 and 4 are the
# same pin. On the ESP8266 the DMX output is fixed to Serial1/GPIO2 by the
# backend, so DMX_TX_PIN is a label there and changing it has no effect.

DMX_TX_PIN=IO4
DMX_DIR_PIN_ENABLED=false
DMX_DIR_PIN=IO18
HOSTNAME=ESP-DMX
AP_SSID=ESP-DMX
AP_PASSWORD=DMX4ALL1
AP_IP=1.1.1.1

STA_IP_MODE=dhcp
STA_STATIC_IP=
STA_STATIC_NETMASK=255.255.255.0
STA_STATIC_GATEWAY=
STA_STATIC_DNS=1.1.1.1

# --- Parent/Child mesh (WIP, stored only, no effect yet) -----------------

MESH_ROLE=none
MESH_SSID=
MESH_PASSWORD=

# --- Devices (numbered groups, each with numbered channels) --------------
# type = slider | button | button-momentary | button-switch

# DEVICE_1_NAME=Studio Par
# DEVICE_1_START_CHANNEL=1
# DEVICE_1_CHANNEL_1_OFFSET=1
# DEVICE_1_CHANNEL_1_NAME=Red
# DEVICE_1_CHANNEL_1_TYPE=slider
# DEVICE_1_CHANNEL_2_OFFSET=2
# DEVICE_1_CHANNEL_2_NAME=Green
# DEVICE_1_CHANNEL_2_TYPE=slider
