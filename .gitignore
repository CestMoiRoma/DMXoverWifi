# PlatformIO build output and metadata
.pio/
.pioenvs/
.piolibdeps/

# IDE
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.idea/

# Local config backup exported from the board (may hold wifi/mqtt secrets)
.env

# The whole LittleFS image is build output: tools/env_to_fsdata.py writes data/
# from .env, and it carries the same WiFi and MQTT passwords as .env itself.
fsdata/

# The web UI compiled into the firmware. tools/pack_web.py regenerates both on
# every build from web/, which is where the UI is actually edited.
src/web_assets.h
src/web_assets.cpp

# OS / filesystem cruft
.DS_Store
Thumbs.db
$RECYCLE.BIN/
System Volume Information/

# Python bytecode from the desktop tool
tools/__pycache__/
