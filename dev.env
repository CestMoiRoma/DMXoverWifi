# Build-time defaults. Committed on purpose: this is the repo's answer, not
# yours.
#
# Two files, two jobs, and the difference matters:
#
#   dev.env   is compiled into the firmware. It decides what a board falls back
#             to when it has nothing saved: the first boot on a blank chip, and
#             every setting a user never touches. Committed.
#
#   .env      seeds one particular board's stored settings, WiFi passwords and
#             all, and is written into the LittleFS image by `uploadfs`.
#             Gitignored, because it holds your credentials.
#
# So a value here is the fallback and a value in .env is a decision already
# made. Where both exist, .env wins, because it lands as a stored setting and
# stored settings are what the firmware reads first.
#
# Every value is compiled as a string except the keys tools/dev_env.py lists as
# numeric, currently WS_PORT_NUMBER alone. A password of nothing but digits is
# therefore still a password rather than an integer.
#
# The matching #define in src/config.h or src/version.h stays as a fallback, so
# deleting a line here compiles rather than breaking, and a hand-rolled build
# with no dev.env still has sensible answers.

# --- identity -----------------------------------------------------------
# FW_VERSION is what the board reports, what the update check compares against
# and what the release workflow insists the tag agrees with. Bump it here and
# nowhere else.

FW_VERSION=0.2.0

REPO_URL=https://github.com/CestMoiRoma/DMXoverWifi
AUTHOR_NAME=CestMoiRoma
AUTHOR_URL=https://github.com/CestMoiRoma

# --- the board on the network -------------------------------------------
# The hostname doubles as the mDNS name, so this board answers to
# http://esp-dmx.local as well as its address.

DEFAULT_HOSTNAME=ESP-DMX

# The config hotspot, raised when no known network answers. It is how a board
# is reached at a venue whose WiFi it has never met, so the password is a real
# one rather than an empty string.

DEFAULT_AP_SSID=ESP-DMX
DEFAULT_AP_PASSWORD=DMX4ALL1
DEFAULT_AP_IP=1.1.1.1

# Used when a static address is configured with no DNS server named.
DEFAULT_DNS=1.1.1.1

# The websocket cannot share port 80 with the web server, so it gets its own.
WS_PORT_NUMBER=81

# --- DMX ----------------------------------------------------------------
# Pin labels are cosmetic, only the digits matter: IO4, GPIO4 and 4 are the same
# pin. On the ESP8266 the output is fixed to Serial1/GPIO2 by the backend, so
# its pin is a label and nothing else.

DEFAULT_DMX_TX_PIN=IO4
DEFAULT_DMX_TX_PIN_ESP8266=GPIO2
DEFAULT_DMX_DIR_PIN=IO18

# --- MQTT ---------------------------------------------------------------
# Where the bridge publishes when nobody has said otherwise. The discovery
# prefix is Home Assistant's own default; changing it means changing it there
# too.

DEFAULT_MQTT_BASE_TOPIC=dmxwifi
DEFAULT_MQTT_DISCOVERY_PREFIX=homeassistant
DEFAULT_MQTT_PORT=1883
